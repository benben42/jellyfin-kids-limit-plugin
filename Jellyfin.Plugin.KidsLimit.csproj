<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.KidsLimit</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.KidsLimit</AssemblyName>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Version>1.1.0.0</Version>
    <FileVersion>1.1.0.0</FileVersion>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="10.11.11" />
    <PackageReference Include="Jellyfin.Model" Version="10.11.11" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Configuration\configPage.html" />
    <EmbeddedResource Include="Web\dashboard.html" />
    <EmbeddedResource Include="Web\kid.html" />
    <EmbeddedResource Include="Web\parent.html" />
    <!-- Chore tile art. Raster wins over SVG for the same key (see ChoreClipart.Formats),
         so dropping a new PNG in is all it takes to replace legacy line art. -->
    <EmbeddedResource Include="Web\clipart\*.svg" />
    <EmbeddedResource Include="Web\clipart\*.png" />
    <EmbeddedResource Include="Web\clipart\*.webp" />
    <EmbeddedResource Include="Web\clipart\*.jpg" />
  </ItemGroup>

</Project>
